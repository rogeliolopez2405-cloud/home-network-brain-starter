# Home Network BRAIN Starter — host configuration.
# install.sh copies this to /etc/hnb/hnb.env (root:hnb, 0640) on first install
# and fills in the @...@ values. Nothing in this file is secret: the vault key
# lives in /var/lib/hnb/secrets/vault.key and is referenced, never copied here.

# Release to run (install.sh keeps this in step with /opt/hnb).
HNB_VERSION=@VERSION@

# The host's `hnb` service account; the container runs as this uid:gid.
HNB_UID=@UID@
HNB_GID=@GID@

# Where data, backups, logs and the vault key live on the host.
HNB_ROOT=/var/lib/hnb

# Web port, and the address it is published on. 0.0.0.0 = every interface;
# the hub itself refuses callers outside the home network either way.
HNB_PORT=@PORT@
HNB_BIND=0.0.0.0

# Ship with the fictional demo home so a fresh install has devices to try.
HNB_ENABLE_DEMO=@DEMO@

# How often providers are polled, in seconds.
HNB_POLL_INTERVAL_S=30

# Nightly backups kept on the hub.
HNB_BACKUP_KEEP=14

TZ=@TZ@

# Network interface the Matter server advertises on (detected by install.sh).
HNB_MATTER_INTERFACE=@IFACE@
