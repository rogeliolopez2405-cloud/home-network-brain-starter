{
  "components": {
    "schemas": {
      "ActionBody": {
        "properties": {
          "capability": {
            "maxLength": 40,
            "title": "Capability",
            "type": "string"
          },
          "confirm": {
            "default": false,
            "title": "Confirm",
            "type": "boolean"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "capability"
        ],
        "title": "ActionBody",
        "type": "object"
      },
      "BootstrapBody": {
        "properties": {
          "house_name": {
            "default": "My Home",
            "maxLength": 120,
            "title": "House Name",
            "type": "string"
          },
          "passphrase": {
            "maxLength": 1024,
            "title": "Passphrase",
            "type": "string"
          },
          "setup_code": {
            "maxLength": 64,
            "title": "Setup Code",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "setup_code",
          "username",
          "passphrase"
        ],
        "title": "BootstrapBody",
        "type": "object"
      },
      "DevicePatch": {
        "properties": {
          "clear_room": {
            "default": false,
            "title": "Clear Room",
            "type": "boolean"
          },
          "favorite": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Favorite"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "room_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room Id"
          },
          "room_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room Name"
          }
        },
        "title": "DevicePatch",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginBody": {
        "properties": {
          "passphrase": {
            "maxLength": 1024,
            "title": "Passphrase",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "passphrase"
        ],
        "title": "LoginBody",
        "type": "object"
      },
      "PairBody": {
        "properties": {
          "code": {
            "description": "The device's setup code (e.g. Matter 11-digit code).",
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "PairBody",
        "type": "object"
      },
      "ProviderBody": {
        "properties": {
          "provider_id": {
            "description": "An installed provider id, e.g. `demo`, `matter`.",
            "maxLength": 40,
            "title": "Provider Id",
            "type": "string"
          },
          "secrets": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Values for the provider's `secrets` fields. Stored encrypted; never returned.",
            "title": "Secrets",
            "type": "object"
          },
          "settings": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Values for the provider's `settings` fields.",
            "title": "Settings",
            "type": "object"
          }
        },
        "required": [
          "provider_id"
        ],
        "title": "ProviderBody",
        "type": "object"
      },
      "ProviderSettingsBody": {
        "properties": {
          "secrets": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Replacement credentials; blank keeps the stored one.",
            "title": "Secrets",
            "type": "object"
          },
          "settings": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Changed settings (merged into the stored ones).",
            "title": "Settings",
            "type": "object"
          }
        },
        "title": "ProviderSettingsBody",
        "type": "object"
      },
      "ReviewBody": {
        "properties": {
          "status": {
            "enum": [
              "MINE",
              "NOT_MINE",
              "IGNORED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReviewBody",
        "type": "object"
      },
      "RoomBody": {
        "properties": {
          "name": {
            "maxLength": 120,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "RoomBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The Home Network BRAIN Starter API \u2014 the same API the Home Hub uses.\n\n**Auth.** Sign in with `POST /api/auth/login`; the session is an HttpOnly cookie.\nEvery write (POST/PATCH/DELETE) also needs the session's CSRF token in the\n`X-CSRF-Token` header (returned by login and `GET /api/session`).\n\n**Network.** The hub answers only callers on the home network, loopback or a\nprivate overlay; others get 403.\n\n**Errors.** Failures return `{\"error\": \"<plain-English reason>\"}` with a 4xx/5xx\nstatus. Device commands report truthful outcomes (see `POST /api/devices/{id}/actions`).\n",
    "title": "Home Network BRAIN Starter",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/audit": {
      "get": {
        "description": "Page with `before=<seq>`; filter with `target=<device/room/provider id>`.",
        "operationId": "audit_api_audit_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "target",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Target"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Append-only history, newest first",
        "tags": [
          "audit"
        ]
      }
    },
